#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200// default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        delete_rest: delete_rest {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B>;
            label = "delete_rest_label";
        };

        all_sel: all_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "ALL_SEL";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            label = "NEW_MACRO";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        cs: cs {
            compatible = "zmk,behavior-hold-tap";
            label = "CS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <135>;
        };

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <135>;
            flavor = "balanced";
            bindings = <&shifted>, <&kp>;
        };

        sk_mod: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <135>;
            bindings = <&kp>, <&sk>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        del_right_mac: del_right_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(RIGHT)) &kp BACKSPACE>;
            label = "DEL_RIGHT_MAC";
        };

        del_left_mac: del_left_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LEFT)) &kp BACKSPACE>;
            label = "DEL_LEFT";
        };

        del_all: del_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END) &kp DEL>;
            label = "DEL_ALL";
        };

        e_enter: e_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp ENTER>;
            label = "E_ENTER";
        };

        ctrl_v_v_ent: ctrl_v_v_ent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(LC(V))>,
                <&macro_wait_time 100>,
                <&kp V>,
                <&macro_wait_time 100>,
                <&kp ENTER>;

            label = "CTRL_V_V_ENT";
        };

        td_ang: td_ang {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ANG";
            #binding-cells = <0>;
            tapping-term-ms = <135>;
            bindings = <&mt GT LT>, <&kp GT &kp LT &kp LEFT>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";
        combo_timeout_ms = <30>;

        to_func {
            bindings = <&mo 2>;
            key-positions = <31 30 66>;
            layers = <0>;
            slow-release;
        };

        to_alpah {
            bindings = <&mo 6>;
            key-positions = <66 31 32>;
            layers = <0>;
            slow-release;
        };

        to_arr2 {
            bindings = <&mo 7>;
            key-positions = <66 31 32 30>;
            layers = <0>;
            slow-release;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <66 29>;
            layers = <0>;
            slow-release;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <66 31>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <32 66>;
            layers = <0>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <66 19>;
            layers = <0>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <66 33>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <17 66>;
            layers = <0>;
        };

        pgdn {
            bindings = <&kp PG_DN>;
            key-positions = <66 30>;
            layers = <0>;
        };

        pgup {
            bindings = <&kp PG_UP>;
            key-positions = <16 66>;
            layers = <0>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <66 18>;
            layers = <0>;
        };

        ins {
            bindings = <&kp INS>;
            key-positions = <15 66>;
            layers = <0>;
        };

        sk_C {
            bindings = <&sk LEFT_CONTROL>;
            key-positions = <13 45>;
            layers = <0>;
        };

        sk_A {
            bindings = <&sk LEFT_ALT>;
            key-positions = <13 27>;
            layers = <0>;
        };

        sk_S {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <13 12>;
            layers = <0>;
        };

        sk_CS {
            bindings = <&sk LEFT_GUI>;
            key-positions = <45 27>;
            layers = <0>;
        };

        sk_CA {
            bindings = <&sk LC(LEFT_ALT)>;
            key-positions = <11 12>;
            layers = <0>;
        };

        sk_CAS {
            bindings = <&sk LEFT_GUI>;
            key-positions = <11 13>;
            layers = <0>;
        };

        sk_AS {
            bindings = <&sk LEFT_GUI>;
            key-positions = <11 12>;
            layers = <0>;
        };

        sk_CW {
            bindings = <&sk LEFT_GUI>;
            key-positions = <13 26>;
            layers = <0>;
        };

        dt_right {
            bindings = <&kp LG(LC(RIGHT))>;
            key-positions = <49 50>;
            layers = <0>;
        };

        dt_left {
            bindings = <&kp LG(LC(LEFT))>;
            key-positions = <48 49>;
            layers = <0>;
        };

        left_sel {
            bindings = <&kp LC(LS(LEFT_ARROW))>;
            key-positions = <56 55>;
            layers = <0>;
        };

        right_sel {
            bindings = <&kp LC(LS(RIGHT))>;
            key-positions = <57 56>;
            layers = <0>;
        };

        all_sel {
            bindings = <&kp B>;
            key-positions = <55 56 57>;
            layers = <0>;
        };

        del_right {
            bindings = <&del_right_mac>;
            key-positions = <32 31>;
            layers = <0>;
        };

        del_left {
            bindings = <&del_left_mac>;
            key-positions = <31 30>;
            layers = <0>;
        };

        del_all {
            bindings = <&del_all>;
            key-positions = <30 31 32>;
            layers = <0>;
        };

        mov_left {
            bindings = <&kp LC(LEFT)>;
            key-positions = <42 41>;
            layers = <0>;
        };

        mov_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <42 43>;
            layers = <0>;
        };

        to_top {
            bindings = <&kp LC(A)>;
            key-positions = <27 56>;
        };

        ctrl_c {
            bindings = <&kp LC(C)>;
            key-positions = <49 66>;
            layers = <0>;
        };

        ctrl_Val_v {
            bindings = <&ctrl_v_v_ent>;
            key-positions = <50 66>;
            layers = <0>;
        };

        ctrl_x {
            bindings = <&kp LC(X)>;
            key-positions = <66 48>;
        };

        ctrl_z {
            bindings = <&kp LC(Z)>;
            key-positions = <66 47>;
        };

        wintab {
            bindings = <&kp LG(TAB)>;
            key-positions = <48 49 50>;
        };

        win_left {
            bindings = <&kp LG(LEFT)>;
            key-positions = <49 48 66>;
        };

        win_right {
            bindings = <&kp LG(RIGHT)>;
            key-positions = <49 66 50>;
        };

        win_up {
            bindings = <&kp LG(UP)>;
            key-positions = <49 48 50 66>;
        };

        win_down {
            bindings = <&kp LG(DOWN)>;
            key-positions = <50 66 48>;
        };

        short_1 {
            bindings = <&kp LG(NUMBER_1)>;
            key-positions = <48 65>;
        };

        short_2 {
            bindings = <&kp LG(NUMBER_2)>;
            key-positions = <65 49>;
        };

        short_3 {
            bindings = <&kp LG(NUMBER_3)>;
            key-positions = <65 50>;
        };

        short_4 {
            bindings = <&kp LG(NUMBER_4)>;
            key-positions = <65 30>;
        };

        short_5 {
            bindings = <&kp LG(NUMBER_5)>;
            key-positions = <65 31>;
        };

        short_6 {
            bindings = <&kp LG(NUMBER_6)>;
            key-positions = <65 32>;
        };

        short_7 {
            bindings = <&kp LG(NUMBER_7)>;
            key-positions = <65 16>;
        };

        short_8 {
            bindings = <&kp LG(NUMBER_8)>;
            key-positions = <65 17>;
        };

        short_9 {
            bindings = <&kp LG(NUMBER_9)>;
            key-positions = <65 18>;
        };

        engkor {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <51 66>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans  &kp NUMBER_1               &kp NUMBER_2         &kp NUMBER_3               &kp NUMBER_4                   &kp N5  &kp KP_NUM                                                               &trans     &cs SEMI COLON  &cs AMPERSAND BACKSLASH  &cs CARET HASH  &cs AT_SIGN DLLR  &cs GRAVE TILDE    &kp LANG1
&trans  &as Q                      &as W                &as E                      &as R                          &as T   &trans                                                                   &trans     &as Y           &as U                    &as I           &as O             &as P              &trans
&trans  &as A                      &as S                &as D                      &as F                          &as G   &kp LC(Q)   &kp LEFT_ALT  &kp LEFT_GUI        &kp LEFT_GUI   &caps_word  &trans     &as H           &as J                    &as K           &as L             &cs PIPE UNDER     &trans
&trans  &as Z                      &as X                &as C                      &as V                          &as B                             &kp LCTRL           &mo 4                                 &as N           &as M                    &kp COMMA       &kp DOT           &cs EXCL QUESTION  &trans
&trans  &sk_mod LEFT_WIN LEFT_WIN  &sk_mod LCTRL LCTRL  &sk_mod LEFT_ALT LEFT_ALT  &sk_mod LEFT_SHIFT LEFT_SHIFT          &kp BSPC    &mo 1         &kp LEFT_SHIFT      &kp RIGHT_ALT  &kp ENTER   &kp SPACE                  &kp UP                   &kp LEFT        &kp RIGHT         &kp DOWN           &trans
            >;
        };

        num_sym {
            bindings = <
&bootloader  &kp NUMBER_6       &kp N7           &kp N8           &kp N9           &kp N0           &trans                                                &trans  &trans                                  &trans                      &trans    &trans     &trans  &bootloader
&trans       &cs CARET PERCENT  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp EQUAL        &trans                                                &trans  &cs RIGHT_BRACKET LEFT_BRACKET          &kp DOUBLE_QUOTES           &kp UP    &kp SQT    &trans  &trans
&trans       &kp KP_DIVIDE      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans  &trans  &trans      &trans          &kp CAPS  &trans  &cs RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp LEFT                    &kp DOWN  &kp RIGHT  &trans  &trans
&trans       &kp KP_MINUS       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS                      &trans      &trans                            &cs RIGHT_BRACE LEFT_BRACE              &cs GREATER_THAN LESS_THAN  &trans    &trans     &trans  &trans
&trans       &trans             &kp PERIOD       &kp KP_NUMBER_0  &kp ENTER                         &mo 3   &trans  &trans      &kp LANGUAGE_2  &trans    &trans                                          &trans                      &trans    &trans     &trans  &trans
            >;
        };

        func {
            bindings = <
&bt BT_SEL 0  &bt BT_CLR                 &kp F10              &kp F11                    &kp F12                        &kp C_VOL_UP   &kp KP_NUM                                                &trans  &kp KP_NUMLOCK                          &kp SCROLLLOCK              &kp PAUSE_BREAK  &trans     &trans  &bl BL_INC
&bt BT_SEL 1  &kp LG(LS(C))              &kp F7               &kp F8                     &kp F9                         &kp C_VOL_DN   &kp C_AL_MY_COMPUTER                                      &trans  &cs RIGHT_BRACKET LEFT_BRACKET          &kp DOUBLE_QUOTES           &kp UP           &kp SQT    &trans  &bl BL_DEC
&bt BT_SEL 3  &kp LA(LG(SPACE))          &kp F4               &kp F5                     &kp F6                         &kp K_MUTE     &kp LG(LC(T))         &trans  &trans      &trans  &trans  &trans  &cs RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp LEFT                    &kp DOWN         &kp RIGHT  &trans  &bl BL_ON
&out OUT_BLE  &kp LG(LS(T))              &kp F1               &kp F2                     &kp F3                         &kp LG(LS(S))                                &trans      &trans                  &as_ht RIGHT_BRACE LEFT_BRACE           &cs GREATER_THAN LESS_THAN  &trans           &trans     &trans  &bl BL_OFF
&out OUT_USB  &sk_mod LEFT_WIN LEFT_WIN  &sk_mod LCTRL LCTRL  &sk_mod LEFT_ALT LEFT_ALT  &sk_mod LEFT_SHIFT LEFT_SHIFT                 &trans                &mo 2   &trans      &trans  &trans  &trans                                          &trans                      &trans           &trans     &trans  &trans
            >;
        };

        num_sym_left {
            bindings = <
&bootloader  &trans                     &trans               &trans                     &trans                         &trans  &trans                                      &trans  &trans  &trans         &trans    &trans         &trans  &bootloader
&trans       &trans                     &kp LC(PG_UP)        &kp UP                     &kp LC(PG_DN)                  &trans  &trans                                      &trans  &trans  &kp LC(PG_UP)  &kp UP    &kp LC(PG_DN)  &trans  &trans
&trans       &trans                     &kp LEFT             &kp DOWN                   &kp RIGHT                      &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LEFT       &kp DOWN  &kp RIGHT      &trans  &trans
&trans       &trans                     &trans               &trans                     &trans                         &trans                  &trans      &trans                  &trans  &trans         &trans    &trans         &trans  &trans
&trans       &sk_mod LEFT_WIN LEFT_WIN  &sk_mod LCTRL LCTRL  &sk_mod LEFT_ALT LEFT_ALT  &sk_mod LEFT_SHIFT LEFT_SHIFT          &trans  &trans  &trans      &trans  &trans  &trans          &trans         &trans    &trans         &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans  &trans                                      &trans  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &trans  &trans                                      &trans  &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans                  &trans      &trans                  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans          &trans          &trans                   &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans          &trans           &trans  &trans
            >;
        };

        scrl {
            bindings = <
&bl BL_TOG    &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans          &trans          &trans           &trans  &bt BT_SEL 0
&bl BL_CYCLE  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp LC(HOME)    &msc SCRL_UP    &kp LC(END)      &trans  &bt BT_SEL 1
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &bt BT_SEL 2
&trans        &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans          &trans          &trans           &trans  &bt BT_SEL 3
&trans        &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans          &trans           &trans  &bt BT_SEL 4
            >;
        };

        alpha_sub {
            bindings = <
&trans         &trans  &trans  &trans     &trans   &trans             &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &as Y   &as U   &as I      &as O    &as P              &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp BACKSPACE  &as H   &as J   &as K      &as L    &cs PIPE UNDER     &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &as N   &as M   &kp COMMA  &kp DOT  &cs EXCL QUESTION                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans         &trans  &trans  &trans     &trans                      &trans  &mo 6   &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        winmode {
            bindings = <
&trans  &trans  &trans        &trans        &trans         &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &kp LG(UP)    &trans         &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans         &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans                 &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        scroll_layer {
            if-layers = <1 4>;
            then-layer = <5>;
        };
    };
};
