#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200// default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        delete_rest: delete_rest {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B>;
            label = "delete_rest_label";
        };

        all_sel: all_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "ALL_SEL";
        };

        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            label = "NEW_MACRO";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        custom_shift: custom_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOM_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <135>;
        };

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <135>;
            flavor = "tap-preferred";
            bindings = <&shifted>, <&kp>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        del_right_mac: del_right_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(RIGHT)) &kp BACKSPACE>;
            label = "DEL_RIGHT_MAC";
        };

        del_left_mac: del_left_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(LEFT)) &kp BACKSPACE>;
            label = "DEL_LEFT";
        };

        del_all: del_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END) &kp DEL>;
            label = "DEL_ALL";
        };

        e_enter: e_enter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp ENTER>;
            label = "E_ENTER";
        };

        td_ang: td_ang {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ANG";
            #binding-cells = <0>;
            tapping-term-ms = <135>;
            bindings = <&mt GT LT>, <&kp GT &kp LT &kp LEFT>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        to_func {
            bindings = <&mo 2>;
            key-positions = <31 30 66>;
            layers = <0>;
        };

        to_arr1 {
            bindings = <&mo 3>;
            key-positions = <66 31 32>;
            layers = <0>;
        };

        to_arr2 {
            bindings = <&mo 3>;
            key-positions = <66 31 32 30>;
            layers = <0>;
        };

        to_arr3 {
            bindings = <&mo 6>;
            key-positions = <66 29>;
            layers = <0>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <66 31>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <32 66>;
            layers = <0>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <66 19>;
            layers = <0>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <66 33>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <17 66>;
            layers = <0>;
        };

        pgdn {
            bindings = <&kp PG_DN>;
            key-positions = <66 30>;
            layers = <0>;
        };

        pgup {
            bindings = <&kp PG_UP>;
            key-positions = <16 66>;
            layers = <0>;
        };

        del {
            bindings = <&kp DEL>;
            key-positions = <66 18>;
            layers = <0>;
        };

        sk_W {
            bindings = <&sk LEFT_GUI>;
            key-positions = <47 66>;
            layers = <0>;
        };

        sk_C {
            bindings = <&sk LEFT_CONTROL>;
            key-positions = <66 48>;
            layers = <0>;
        };

        sk_A {
            bindings = <&sk LEFT_ALT>;
            key-positions = <66 49>;
            layers = <0>;
        };

        sk_S {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <66 50>;
            layers = <0>;
        };

        sk_CS {
            bindings = <&sk LEFT_GUI>;
            key-positions = <66 48 50>;
            layers = <0>;
        };

        sk_CA {
            bindings = <&sk LC(LEFT_ALT)>;
            key-positions = <66 48 49>;
            layers = <0>;
        };

        sk_CAS {
            bindings = <&sk LEFT_GUI>;
            key-positions = <66 48 49 50>;
            layers = <0>;
        };

        sk_AS {
            bindings = <&sk LEFT_GUI>;
            key-positions = <66 49 50>;
            layers = <0>;
        };

        sk_CW {
            bindings = <&sk LEFT_GUI>;
            key-positions = <47 66 48>;
            layers = <0>;
        };

        dt_right {
            bindings = <&kp LG(LC(RIGHT))>;
            key-positions = <49 50>;
            layers = <0>;
        };

        dt_left {
            bindings = <&kp LG(LC(LEFT))>;
            key-positions = <48 49>;
            layers = <0>;
        };

        left_sel {
            bindings = <&kp LC(LS(LEFT_ARROW))>;
            key-positions = <56 55>;
            layers = <0>;
        };

        right_sel {
            bindings = <&kp LC(LS(RIGHT))>;
            key-positions = <57 56>;
            layers = <0>;
        };

        all_sel {
            bindings = <&kp B>;
            key-positions = <55 56 57>;
            layers = <0>;
        };

        del_right {
            bindings = <&del_right_mac>;
            key-positions = <32 31>;
            layers = <0>;
        };

        del_left {
            bindings = <&del_left_mac>;
            key-positions = <31 30>;
            layers = <0>;
        };

        del_all {
            bindings = <&del_all>;
            key-positions = <30 31 32>;
            layers = <0>;
        };

        mov_left {
            bindings = <&kp LC(LEFT)>;
            key-positions = <42 41>;
            layers = <0>;
        };

        mov_right {
            bindings = <&kp LC(RIGHT)>;
            key-positions = <42 43>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC        &as Y      &as U    &as I     &as O        &kp P  &tog 1                                                                   &mo 3      &as_ht SEMI COLON  &as_ht AMPERSAND BACKSLASH  &as_ht CARET HASH  &as_ht AT_SIGN DLLR  &as_ht GRAVE TILDE    &kp LANG2
&kp TAB        &as Q      &as W    &as E     &as R        &as T  &caps_word                                                               &none      &as Y              &as U                       &as I              &as O                &as P                 &kp RIGHT
&kp LC(COMMA)  &as A      &as S    &as D     &as F        &as G  &none       &kp LEFT_ALT  &kp LEFT_GUI        &kp LGUI       &caps_word  &none      &as H              &as J                       &as K              &as L                &as_ht PIPE UNDER     &e_enter
&kp LG(LEFT)   &as Z      &as X    &as C     &as V        &as B                            &kp LCTRL           &mo 4                                 &as N              &as M                       &as COMMA          &as DOT              &as_ht EXCL QUESTION  &kp LG(RIGHT)
&bootloader    &kp GRAVE  &kp DOT  &kp LEFT  &kp LG(TAB)         &kp BSPC    &mo 1         &kp LEFT_SHIFT      &kp RIGHT_ALT  &kp ENTER   &kp SPACE                     &kp UP                      &kp LEFT           &kp RIGHT            &kp RBKT              &bootloader
            >;
        };

        num_sym {
            bindings = <
&bootloader  &trans         &trans           &trans           &trans           &trans           &kp M                                             &mo 3      &trans                                     &trans             &trans     &trans      &trans        &bootloader
&trans       &kp PERCENT    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_EQUAL     &trans                                            &trans     &as_ht RIGHT_BRACKET LEFT_BRACKET          &kp DOUBLE_QUOTES  &kp UP     &kp SQT     &kp KP_MINUS  &kp BSLH
&trans       &kp KP_DIVIDE  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans  &trans  &trans      &kp LGUI   &kp CAPS   &trans     &as_ht RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp LEFT           &kp DOWN   &kp RIGHT   &kp KP_PLUS   &trans
&trans       &kp KP_MINUS   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS                      &trans      &kp PG_UP                        &kp N                                      &td_ang            &kp KP_N2  &kp KP_N3   &kp KP_ENTER  &kp RSHFT
&sys_reset   &kp CARET      &kp PERIOD       &kp KP_NUMBER_0  &kp ENTER                         &mo 3   &trans  &trans      &kp PG_DN  &kp ENTER  &kp KP_N0                                             &kp UP             &kp DOWN   &kp KP_DOT  &kp RBKT      &sys_reset
            >;
        };

        func {
            bindings = <
&trans  &trans         &kp F10     &kp F11  &kp F12               &kp C_VOL_UP   &tog 1                                      &mo 3   &trans  &trans             &trans     &trans      &trans        &bt BT_SEL 0
&trans  &kp LG(LS(C))  &kp F7      &kp F8   &kp F9                &kp C_VOL_DN   &none                                       &none   &kp Y   &kp DOUBLE_QUOTES  &kp UP     &kp SQT     &kp KP_MINUS  &bt BT_SEL 1
&trans  &kp LA(SPACE)  &kp F4      &kp F5   &kp F6                &kp K_MUTE     &none   &trans  &trans      &trans  &trans  &none   &kp H   &kp LEFT           &kp DOWN   &kp RIGHT   &kp KP_PLUS   &bt BT_SEL 2
&trans  &kp LG(LS(T))  &kp F1      &kp F2   &kp F3                &kp LG(LS(S))                  &trans      &trans                  &kp N   &td_ang            &kp KP_N2  &kp KP_N3   &kp KP_ENTER  &out OUT_TOG
&trans  &kp LG(LC(T))  &kp K_CALC  &trans   &kp C_AL_MY_COMPUTER                 &trans  &mo 2   &trans      &trans  &trans  &trans          &kp UP             &kp DOWN   &kp KP_DOT  &kp RBKT      &sys_reset
            >;
        };

        num_sym_left {
            bindings = <
&bootloader  &trans    &trans             &trans    &trans         &trans  &trans                                      &trans  &trans  &trans         &trans    &trans         &trans    &bootloader
&trans       &trans    &kp LC(PAGE_DOWN)  &kp UP    &kp LC(PG_UP)  &trans  &trans                                      &trans  &trans  &kp LC(PG_DN)  &kp UP    &kp LC(PG_UP)  &trans    &trans
&trans       &trans    &kp LEFT           &kp DOWN  &kp RIGHT      &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp LEFT       &kp DOWN  &kp RIGHT      &trans    &trans
&trans       &kp LGUI  &kp LCTRL          &kp LALT  &kp LSHFT      &trans                  &trans      &trans                  &trans  &kp RSHFT      &kp RALT  &kp RCTRL      &kp RGUI  &trans
&trans       &trans    &trans             &trans    &trans                 &trans  &trans  &trans      &trans  &trans  &trans          &trans         &trans    &trans         &trans    &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &none   &trans  &trans  &trans                                      &trans  &trans  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &trans  &trans
&trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans          &trans           &trans  &trans
            >;
        };

        scrl {
            bindings = <
&bl BL_TOG    &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans          &trans          &trans           &trans  &bt BT_SEL 0
&bl BL_CYCLE  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp LC(HOME)    &msc SCRL_UP    &kp LC(END)      &trans  &bt BT_SEL 1
&trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans  &bt BT_SEL 2
&trans        &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans          &trans          &trans           &trans  &bt BT_SEL 3
&trans        &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans          &trans           &trans  &bt BT_SEL 4
            >;
        };

        alpha_sub {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &mo 6   &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        scroll_layer {
            if-layers = <1 4>;
            then-layer = <5>;
        };
    };
};
